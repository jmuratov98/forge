# Forge's version (ADR 0001): composed here, written to the build tree.
#
#   X.Y.Z[-{alpha|beta|rc}[.N]]+dev.{YYYYMMDDHHMMSS}.g{shortsha}   CI builds
#   X.Y.Z[-{alpha|beta|rc}[.N]]+dev.local                          local builds
#
# X.Y.Z comes from project(forge VERSION ...), the stage from FORGE_VERSION_STAGE.
# CI passes the timestamp and the commit as FORGE_BUILD_TIMESTAMP and
# FORGE_BUILD_SHA. This never runs git: a source tarball has no tags.

# An empty STAGE, TIMESTAMP or SHA is an empty string, not an unset variable.
if(POLICY CMP0174)
  cmake_policy(SET CMP0174 NEW)
endif()

# forge_compose_version(<out-var>
#   VERSION <X.Y.Z> [STAGE <stage>] [TIMESTAMP <YYYYMMDDHHMMSS> SHA <7 hex>])
function(forge_compose_version out_var)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "VERSION;STAGE;TIMESTAMP;SHA" "")

  set(number "(0|[1-9][0-9]*)")
  if(NOT "${ARG_VERSION}" MATCHES "^${number}\\.${number}\\.${number}$")
    message(FATAL_ERROR
      "Forge: the version '${ARG_VERSION}' must be exactly X.Y.Z "
      "(project(forge VERSION ...) takes three numbers; the stage is separate).")
  endif()
  set(result "${ARG_VERSION}")

  if(NOT "${ARG_STAGE}" STREQUAL "")
    if(NOT "${ARG_STAGE}" MATCHES "^(alpha|beta|rc)(\\.[1-9][0-9]*)?$")
      message(FATAL_ERROR
        "Forge: the version stage '${ARG_STAGE}' must be alpha, beta or rc, "
        "optionally followed by .N with N >= 1 (ADR 0001).")
    endif()
    string(APPEND result "-${ARG_STAGE}")
  endif()

  if("${ARG_TIMESTAMP}" STREQUAL "" AND "${ARG_SHA}" STREQUAL "")
    string(APPEND result "+dev.local")
  elseif("${ARG_TIMESTAMP}" STREQUAL "" OR "${ARG_SHA}" STREQUAL "")
    message(FATAL_ERROR
      "Forge: FORGE_BUILD_TIMESTAMP and FORGE_BUILD_SHA must be given together.")
  else()
    string(LENGTH "${ARG_TIMESTAMP}" timestamp_length)
    if(NOT timestamp_length EQUAL 14 OR NOT "${ARG_TIMESTAMP}" MATCHES "^[0-9]+$")
      message(FATAL_ERROR
        "Forge: FORGE_BUILD_TIMESTAMP '${ARG_TIMESTAMP}' must be 14 digits, "
        "YYYYMMDDHHMMSS in UTC.")
    endif()
    string(LENGTH "${ARG_SHA}" sha_length)
    if(NOT sha_length EQUAL 7 OR NOT "${ARG_SHA}" MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR
        "Forge: FORGE_BUILD_SHA '${ARG_SHA}' must be the first 7 lowercase "
        "hex characters of the commit.")
    endif()
    string(APPEND result "+dev.${ARG_TIMESTAMP}.g${ARG_SHA}")
  endif()

  set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

# forge_generate_version_header(<path> <version-string>)
#
# Writes the private version.inc.hpp. file(CONFIGURE) leaves the file alone
# when its content is unchanged, so reconfiguring a local build rebuilds nothing.
function(forge_generate_version_header path version_string)
  file(CONFIGURE OUTPUT "${path}" @ONLY NEWLINE_STYLE UNIX CONTENT
"// Generated by CMake at configure time. Do not edit.
#pragma once

#define FORGE_VERSION_STRING \"@version_string@\"
")
endfunction()

# Composes the version for this build, writes it into the build tree, and
# sets FORGE_VERSION_STRING.
function(forge_configure_version)
  set(FORGE_BUILD_TIMESTAMP "" CACHE STRING
    "UTC time CI stamps into dev versions, YYYYMMDDHHMMSS (ADR 0001)")
  set(FORGE_BUILD_SHA "" CACHE STRING
    "First 7 hex characters of the commit CI stamps into dev versions")

  forge_compose_version(version_string
    VERSION "${PROJECT_VERSION}"
    STAGE "${FORGE_VERSION_STAGE}"
    TIMESTAMP "${FORGE_BUILD_TIMESTAMP}"
    SHA "${FORGE_BUILD_SHA}")
  forge_generate_version_header(
    "${CMAKE_BINARY_DIR}/generated/version.inc.hpp" "${version_string}")

  message(STATUS "Forge version: ${version_string}")
  set(FORGE_VERSION_STRING "${version_string}" PARENT_SCOPE)
endfunction()
