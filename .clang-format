---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20

IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
NamespaceIndentation: None
IndentPPDirectives: AfterHash
PPIndentWidth: 2
FixNamespaceComments: true

BreakBeforeBraces: Attach
InsertBraces: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
Cpp11BracedListStyle: true

QualifierAlignment: Left
PointerAlignment: Left
BinPackArguments: false
BinPackParameters: false
BreakTemplateDeclarations: Yes

SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeIsMainRegex: '(_test)?$'

# forge/core/config.hpp macros that expand to pragmas and stand alone on their line.
StatementMacros:
  - FORGE_WARNINGS_PUSH
  - FORGE_WARNINGS_POP
  - FORGE_WARNING_IGNORE_CLANG
  - FORGE_WARNING_IGNORE_GCC
  - FORGE_WARNING_IGNORE_MSVC
IncludeCategories:
  # forge headers
  - Regex: '^"forge/'
    Priority: 2
  # other quoted (local) headers
  - Regex: '^"'
    Priority: 1
  # C++ standard library: <vector>, <string_view>
  - Regex: '^<[a-z_0-9]+>$'
    Priority: 4
  # third-party headers that would otherwise match the C system rule below
  - Regex: '^<(gtest|gmock)/'
    Priority: 3
  # C system headers: <stdio.h>, <sys/types.h>
  - Regex: '^<[a-z_0-9/]+\.h>$'
    Priority: 5
  # third-party: <gtest/gtest.h>, <llvm/...>
  - Regex: '^<'
    Priority: 3
...
